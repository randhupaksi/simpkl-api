APP_NAME=SIMPKL API
APP_ENV=development
APP_PORT=8080
APP_URL=http://localhost:8080

DB_HOST=localhost
DB_PORT=3306
DB_NAME=simpkl
DB_USER=root
DB_PASSWORD=
DB_MAX_OPEN_CONNECTIONS=25
DB_MAX_IDLE_CONNECTIONS=10
DB_CONNECTION_MAX_LIFETIME=300

# Apply embedded versioned SQL migrations before the API starts.
# Set false only when a separate deployment migration job owns this step.
MIGRATIONS_AUTO_APPLY=true

JWT_ACCESS_SECRET=replace_with_secure_access_secret
JWT_REFRESH_SECRET=replace_with_secure_refresh_secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_HOURS=168

CORS_ALLOWED_ORIGINS=http://localhost:5173
STORAGE_DRIVER=local
STORAGE_PATH=./storage/private
LOG_LEVEL=debug

SEED_ENABLED=true
SEED_RECORD_COUNT=5
SEED_RESET_LEGACY=true
SEED_ADMIN_NAME=Super Admin SIMPKL
SEED_ADMIN_EMAIL=admin@example.sch.id
SEED_ADMIN_USERNAME=superadmin
SEED_ADMIN_PASSWORD=replace_with_at_least_8_characters
